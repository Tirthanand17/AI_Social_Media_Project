# AI Social Media Automation - environment example
# Copy this file to .env before running locally. NEVER commit .env.

# Runtime
APP_ENV=local
APP_SECRET=change_this_to_a_long_random_secret_before_deploying
ALLOWED_ORIGINS=http://127.0.0.1:8010,http://localhost:8010,http://127.0.0.1:8501,http://localhost:8501
APP_DB_PATH=data/processed/ai_social_studio.db
RATE_LIMIT_PER_MINUTE=60

# MySQL path described in PROJECT_GUIDE.md (optional for the self-contained SQLite demo)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change_me
DB_NAME=ai_social_media

# Redis / background services
REDIS_URL=redis://localhost:6379/0

# Backups
BACKUP_TIME=02:00
BACKUP_RETENTION_DAYS=30

# Demo login
# Keep true for local college/internship demo. Set false before live deployment.
DEMO_LOGIN_ENABLED=true
ADMIN_PASSWORD=change_me_admin
EDITOR_PASSWORD=change_me_editor
VIEWER_PASSWORD=change_me_viewer

# More secure production option:
# Generate hash/salt with: python -c "from api.auth import make_password_hash; print(make_password_hash('your_password'))"
# Then set DEMO_LOGIN_ENABLED=false and use these instead of plain passwords.
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD_SALT=
EDITOR_PASSWORD_HASH=
EDITOR_PASSWORD_SALT=
VIEWER_PASSWORD_HASH=
VIEWER_PASSWORD_SALT=

# AI text providers - keep false until you add real keys
AI_TEXT_PROVIDER=demo
USE_GEMINI=false
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
USE_GROQ=false
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant
HUGGINGFACE_API_KEY=your_huggingface_token_here

# Optional image provider. prompt_only prevents paid/external calls by default.
IMAGE_GENERATION_MODE=prompt_only
STABLE_DIFFUSION_API_KEY=your_image_provider_key_here
STABLE_DIFFUSION_API_URL=https://stablediffusionapi.com/api/v3/text2img

# Publishing mode
# dry_run = safe simulation; live = real posting only when credentials are valid
POSTING_MODE=dry_run
LIVE_PLATFORMS=facebook,instagram,x,linkedin,telegram

# Meta / Facebook / Instagram
# META_GRAPH_VERSION is optional. Example: vXX.X for the version supported by your Meta app.
META_GRAPH_VERSION=
FACEBOOK_ACCESS_TOKEN=your_facebook_page_access_token_here
FACEBOOK_PAGE_ID=your_facebook_page_id_here
INSTAGRAM_USER_ID=your_instagram_professional_account_id_here
# Optional separate token; otherwise Instagram uses FACEBOOK_ACCESS_TOKEN.
INSTAGRAM_ACCESS_TOKEN=

# LinkedIn live posting
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token_here
LINKEDIN_AUTHOR_URN=urn:li:person:your_linkedin_person_id
LINKEDIN_VERSION=

# X/Twitter credentials - OAuth user-context is required for real posting
X_API_KEY=your_x_api_key_here
X_API_SECRET=your_x_api_secret_here
X_BEARER_TOKEN=your_x_bearer_token_here
X_ACCESS_TOKEN=your_x_access_token_here
X_ACCESS_TOKEN_SECRET=your_x_access_token_secret_here

# Notifications / weekly reports
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password_here
EMAIL_REPORT_TO=your_email@gmail.com
EMAIL_SEND_ENABLED=false
WEEKLY_REPORT_TIME=09:00
